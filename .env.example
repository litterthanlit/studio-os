NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_INTERNAL_API_SECRET=
CONVEX_ADMIN_EMAILS=
PROVIDER_TOKEN_ENCRYPTION_KEY=
STUDIO_OS_REQUIRE_AUTH=false
STUDIO_OS_DEV_AUTH_BYPASS=true
STUDIO_OS_DISABLE_SCREENSHOT=false
STUDIO_OS_API_URL=http://localhost:3000
STUDIO_OS_API_TOKEN=

# Convex Auth (set on the Convex deployment, not only Next.js)
# SITE_URL is the browser origin Convex redirects to after Google / magic link.
SITE_URL=http://localhost:3000
# CONVEX_SITE_URL is set automatically on the deployment (https://<deployment>.convex.site).
# Google OAuth authorized redirect: https://<deployment>.convex.site/api/auth/callback/google
# JWT_PRIVATE_KEY and JWKS: generate with `node scripts/generate-convex-auth-keys.mjs`
# then `npx convex env set JWT_PRIVATE_KEY ...` and `npx convex env set JWKS ...`
# then `npx convex env set SITE_URL http://localhost:3000` (or the production origin).
JWT_PRIVATE_KEY=
JWKS=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=Studio OS <noreply@studio-os.io>
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AI generation
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Studio OS

# Optional integrations
OPENAI_API_KEY=
LUMMI_API_KEY=
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL=
